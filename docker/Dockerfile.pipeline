# Full build: data pipeline -> training (MLflow) -> XAI -> fairness -> monitoring -> model card -> promotion gate
FROM python:3.11-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 git && rm -rf /var/lib/apt/lists/*
COPY requirements-api.txt requirements-build.txt ./
RUN pip install --no-cache-dir -r requirements-build.txt
COPY . .
ENV MLFLOW_TRACKING_URI=sqlite:////app/mlruns/mlflow.db
CMD ["python", "-m", "careconnect.run_all"]
